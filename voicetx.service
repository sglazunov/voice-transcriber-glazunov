# Reference template. `deploy.sh` generates this unit automatically with the
# right user/path/port, so normally you do NOT edit it by hand. Use it only for
# a manual install:
#   sudo cp voicetx.service /etc/systemd/system/   (after editing the marked lines)
#   sudo systemctl daemon-reload && sudo systemctl enable --now voicetx
[Unit]
Description=Voice Transcriber (speech-to-text + meeting protocols)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- EDIT these to match your server ---
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/voice-transcriber
ExecStart=/home/CHANGE_ME/voice-transcriber/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
# ---------------------------------------
Environment=VTX_MODEL=medium
Environment=VTX_COMPUTE_TYPE=int8
Environment=PYTHONUNBUFFERED=1
# Note: do NOT set a tight MemoryMax here — medium/large-v3 need several GB
# while transcribing and systemd would OOM-kill the job mid-run.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
